DATABASE_URL=postgresql+psycopg://curriculo:curriculo@localhost:5432/curriculo
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
OPENAI_API_KEY=
# Defina explicitamente um modelo compatível com Structured Outputs.
OPENAI_MODEL=
STORAGE_ROOT=./storage
# Railway: use s3 e as credenciais do mesmo bucket na API e nos dois workers.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=virtual
MONTHLY_OPTIMIZATION_LIMIT=5
PREVIEW_TTL_SECONDS=3600
COMPILER_IMAGE=curriculo-tectonic:0.1
# sandbox somente na imagem docker/railway-pdf.Dockerfile (Linux).
COMPILER_BACKEND=docker
COMPILER_TIMEOUT_SECONDS=40
# Entrevista opcional: limites técnicos independentes da cota mensal.
INTERVIEW_QUESTIONS_PER_ROUND=3
INTERVIEW_MAX_ROUNDS=2
INTERVIEW_SESSIONS_PER_DAY=3
INTERVIEW_EXECUTIONS_PER_DAY=12
INTERVIEW_TTL_SECONDS=86400
INTERVIEW_MAX_CONFIRMED_CHARS=12000
INTERVIEW_MAX_CONTEXT_CHARS=120000
INTERVIEW_MAX_OUTPUT_TOKENS=3000
INTERVIEW_CONSENT_VERSION=complementacao-v1
